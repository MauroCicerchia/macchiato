# Regenerate docs/demo.gif with `make demo` (needs vhs: brew install vhs).

Output docs/demo.gif

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set LineHeight 1.0
Set Width 1000
Set Height 620
Set Padding 24
Set Framerate 25
Set TypingSpeed 60ms
Set Theme { "name": "macchiato", "black": "#141618", "red": "#e06c75", "green": "#47c073", "yellow": "#d8a571", "blue": "#61afef", "purple": "#c678dd", "cyan": "#56b6c2", "white": "#c8ccd0", "brightBlack": "#6e747a", "brightRed": "#e06c75", "brightGreen": "#47c073", "brightYellow": "#d8a571", "brightBlue": "#61afef", "brightPurple": "#c678dd", "brightCyan": "#56b6c2", "brightWhite": "#ffffff", "background": "#141618", "foreground": "#c8ccd0", "selectionBackground": "#3e4145", "cursorAccent": "#141618", "cursor": "#c8ccd0" }

Env COLORTERM "truecolor"

Hide
Type `export PS1='$ ' PATH="$PWD/bin:$PATH" && clear`
Enter
Show

Sleep 400ms
Type "macchiato -t 7"
Sleep 400ms
Enter
Sleep 6s
